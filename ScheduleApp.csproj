<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041.0: cần cho API Windows.Media.Ocr (nhận dạng chữ) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UseWPF: chỉ để dùng System.Windows.Automation (UI Automation) cho các bước "Phần tử UI" -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>ScheduleApp</AssemblyName>
    <RootNamespace>ScheduleApp</RootNamespace>
    <Product>ScheduleApp</Product>
    <Version>2.2.2</Version>
    <!-- Project kiểm thử và bộ cài nằm trong cùng thư mục — không biên dịch vào ứng dụng -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;installer/**;publish/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mẫu công việc nhúng sẵn cho mục "Mẫu có sẵn…" -->
    <EmbeddedResource Include="Samples/*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Đọc email IMAP cho trình kích hoạt "Có email mới" -->
    <PackageReference Include="MailKit" Version="4.18.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScheduleApp.Tests" />
  </ItemGroup>

</Project>
